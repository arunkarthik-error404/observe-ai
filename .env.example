# Copy to .env and fill in. Never commit .env.

# Which system of record to use. The adapters are interchangeable, so this one
# variable and a restart is the whole switch.
#   memory     = seeded in-process data; no credentials at all, used by tests
#   salesforce = Contact / Case / Task in a Salesforce org (what production runs)
#   sheets     = Google Sheets
BACKEND=memory

# --- Google Sheets (Integration #1 and #2) ---
# Service-account JSON. Paste the whole thing on one line for hosted envs,
# or point GOOGLE_CREDENTIALS_FILE at the downloaded key file locally.
GOOGLE_CREDENTIALS_JSON=
GOOGLE_CREDENTIALS_FILE=
SHEET_ID=
CUSTOMERS_TAB=Customers
CLAIMS_TAB=Claims
INTERACTIONS_TAB=Interactions

# --- Vapi ---
# Shared secret Vapi sends as x-vapi-secret on every server request. This one is
# yours, not Vapi's: provisioning writes it into each tool's server config, so it
# survives swapping Vapi accounts.
VAPI_SECRET=
# Set true in production so a request without a valid secret is rejected.
REQUIRE_SECRET=false
# Private API key. Read only by scripts/provision_vapi.py — the server never
# needs it, so it does not belong in a hosting dashboard.
VAPI_PRIVATE_KEY=
# Public https base URL of this backend, no trailing slash. Provisioning bakes
# it into every tool's server URL.
SERVER_URL=
# Optional: live warm transfer target for escalations, E.164. Unset means
# escalation offers a callback instead of promising a connection it cannot make.
TRANSFER_PHONE_NUMBER=

# Used only by the browser dialler at /call. The *public* key is meant to be
# exposed in a browser — it can start calls and nothing else. Set these three in
# your hosting dashboard too, or the deployed dialler has nothing to call.
VAPI_PUBLIC_KEY=
# Written back automatically by scripts/provision_vapi.py; leave empty at first.
VAPI_ASSISTANT_ID=
VAPI_SQUAD_ID=

# The inbound number, and its Vapi id. Provisioning points the number at
# whichever --mode it just ran, so provision the squad last if that is what the
# number should reach. Leave VAPI_PHONE_NUMBER_ID empty on a fresh Vapi account:
# a stale id makes provisioning fail at the final step, after the assistants are
# already created.
VAPI_PHONE_NUMBER=
VAPI_PHONE_NUMBER_ID=

# --- Salesforce (BACKEND=salesforce) ---
# App setup and the seeding scripts are in the README, under "Connect a system
# of record".
#
# This must be the org's My Domain URL for the client-credentials flow — the
# generic login.salesforce.com returns invalid_client_id. Use test.salesforce.com
# for a sandbox.
SF_LOGIN_URL=https://login.salesforce.com
# client_credentials needs an id + secret; jwt_bearer needs a key and username.
SF_AUTH_FLOW=client_credentials
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_USERNAME=
# jwt_bearer only: the PEM inline (\n escaped) for hosted envs, or a path to it.
SF_PRIVATE_KEY=
SF_PRIVATE_KEY_FILE=
SF_API_VERSION=v62.0

# --- Slack (Integration #3: escalation notifications) ---
# Incoming Webhook URL from api.slack.com/apps. Empty disables the notifier,
# so the agent runs fine without it.
SLACK_WEBHOOK_URL=

# --- behaviour ---
MAX_AUTH_ATTEMPTS=3
SESSION_TTL_SECONDS=3600
# auto | open | closed — pin this to demo the live-transfer vs callback branch
# of escalation from any timezone.
BUSINESS_HOURS_MODE=auto

# Lifts the mask on /debug/calls and on the Salesforce org URL and remaining
# API quota in /health. Leave it empty and both stay masked in production and
# open locally, so forgetting it fails closed rather than open. Set it in your
# hosting dashboard and open the console as /debug?t=<token> to see real values
# during a demo.
DEBUG_TOKEN=

# Failed identity checks allowed against one phone number, across calls rather
# than within one. MAX_AUTH_ATTEMPTS resets the moment a caller hangs up and
# redials, so on its own it is a speed bump; this is the lockout. Process-local
# like the session store, so a second replica keeps its own count.
MAX_ATTEMPTS_PER_NUMBER=9

# Mask phone numbers, names and dates of birth in the log stream. On by default:
# a claims line handles regulated data and logs outlive the call. Turn it off
# locally to debug a value you cannot otherwise see — never in an environment
# handling real customers.
REDACT_LOGS=true

# --- optional overrides (defaults shown; uncomment to change) ---
# What the agent says the office hours are, and the number it reads out.
#OFFICE_HOURS=Monday to Friday, 8am to 6pm Pacific
#SUPPORT_PHONE=+1-800-555-0142
# Upstream timeouts and retry budget. Keep these well under the voice stack's
# patience: a tool that takes longer than a caller will wait is a failed turn.
#SF_TIMEOUT_SECONDS=10.0
#SHEETS_TIMEOUT_SECONDS=8.0
#SHEETS_MAX_RETRIES=3
