# Copy to .env and fill in. Never commit .env.

# memory = seeded in-process data (no credentials needed, used by tests)
# sheets = Google Sheets as the system of record
BACKEND=memory

# --- Google Sheets (Integration #1 and #2) ---
# Service-account JSON. Paste the whole thing on one line for hosted envs,
# or point GOOGLE_CREDENTIALS_FILE at the downloaded key file locally.
GOOGLE_CREDENTIALS_JSON=
GOOGLE_CREDENTIALS_FILE=
SHEET_ID=
CUSTOMERS_TAB=Customers
CLAIMS_TAB=Claims
INTERACTIONS_TAB=Interactions

# --- Vapi ---
# Shared secret Vapi sends as x-vapi-secret on every server request.
VAPI_SECRET=
# Set true in production so a request without a valid secret is rejected.
REQUIRE_SECRET=false
# Only needed by scripts/provision_vapi.py
VAPI_PRIVATE_KEY=
SERVER_URL=
# Optional: live warm transfer target for escalations, E.164
TRANSFER_PHONE_NUMBER=

# --- Salesforce (alternative system of record: BACKEND=salesforce) ---
# login.salesforce.com for developer/production orgs, test.salesforce.com for
# sandboxes. See docs/SALESFORCE.md for the Connected App setup.
SF_LOGIN_URL=https://login.salesforce.com
# client_credentials needs an id + secret; jwt_bearer needs a key and username.
SF_AUTH_FLOW=client_credentials
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_USERNAME=
SF_PRIVATE_KEY_FILE=
SF_API_VERSION=v62.0

# --- Slack (Integration #3: escalation notifications) ---
# Incoming Webhook URL from api.slack.com/apps. Empty disables the notifier,
# so the agent runs fine without it.
SLACK_WEBHOOK_URL=

# --- behaviour ---
MAX_AUTH_ATTEMPTS=3
SESSION_TTL_SECONDS=3600
# auto | open | closed — pin this to demo the live-transfer vs callback branch
# of escalation from any timezone.
BUSINESS_HOURS_MODE=auto
